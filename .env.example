# ============================================================================
# Konark HRMS — Environment Variables (example)
# Copy this file to `.env` / `.env.local` and fill in real values.
# Never commit real secrets.
# ============================================================================

# PostgreSQL connection string (required for Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Phase 2/3 — authentication feature flags
# ---------------------------------------------------------------------------
USE_REAL_AUTH="false"
NEXT_PUBLIC_USE_REAL_AUTH="false"

# ---------------------------------------------------------------------------
# Phase 4 — real Employee/Department data
# ---------------------------------------------------------------------------
# When false (default), Employee/Department UI uses mock data.
# When true, list/create/update go through server actions → PostgreSQL.
# Requires real auth (USE_REAL_AUTH=true) so server session can resolve tenant.
NEXT_PUBLIC_USE_REAL_DATA="false"

# Legacy mock-data preference (UI modules not yet on real data)
NEXT_PUBLIC_USE_MOCK_DATA="true"

# ---------------------------------------------------------------------------
# Phase 3 — session signing secret (REQUIRED when USE_REAL_AUTH=true)
# Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
