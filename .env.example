# ============================================================================
# Konark HRMS — Environment Variables (example)
# Copy this file to `.env` / `.env.local` and fill in real values.
# Never commit real secrets.
# ============================================================================

# PostgreSQL connection string (required for Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Phase 2/3 — authentication feature flags
# ---------------------------------------------------------------------------
# When false (default), login uses mock users + localStorage session.
# When true, real DB auth + HTTP-only signed cookies are used.
USE_REAL_AUTH="false"

# Client-visible mirror (required so the browser auth-service can branch).
# Must match USE_REAL_AUTH for consistent behaviour.
NEXT_PUBLIC_USE_REAL_AUTH="false"

# Keep UI on mock data until data phases cut over
NEXT_PUBLIC_USE_MOCK_DATA="true"

# ---------------------------------------------------------------------------
# Phase 3 — session signing secret (REQUIRED when USE_REAL_AUTH=true)
# Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
