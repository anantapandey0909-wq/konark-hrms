# ==============================================================================
# Konark HRMS — Environment Variables (example)
# Copy this file to `.env` and fill in real values. Never commit real secrets.
# ==============================================================================

# PostgreSQL connection string (required for Prisma)
# Example local: postgresql://USER:PASSWORD@localhost:5432/konark_hrms?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Application
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Future (Phase 2+) — authentication & session
# ---------------------------------------------------------------------------
# AUTH_SECRET="generate-a-long-random-string"
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="generate-a-long-random-string"

# ---------------------------------------------------------------------------
# Optional feature flags (for gradual mock → real data cut-over)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_USE_MOCK_DATA="true"
