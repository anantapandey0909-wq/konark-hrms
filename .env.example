# ============================================================================
# Konark HRMS — Environment Variables (example)
# Copy this file to `.env` / `.env.local` and fill in real values.
# Never commit real secrets.
# ============================================================================

# PostgreSQL connection string (required for Prisma)
# Example local: postgresql://USER:PASSWORD@localhost:5432/konark_hrms?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Application
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Phase 2 — authentication feature flags
# ---------------------------------------------------------------------------
# When false (default), login uses mock users + localStorage session.
# When true, real auth is expected (Phase 3 completes the implementation).
USE_REAL_AUTH="false"

# Optional client-visible mirror (prefer server USE_REAL_AUTH for security decisions)
# NEXT_PUBLIC_USE_REAL_AUTH="false"

# Keep UI on mock data until data phases cut over
NEXT_PUBLIC_USE_MOCK_DATA="true"

# ---------------------------------------------------------------------------
# Future (Phase 3+) — session secrets (do not use until real auth ships)
# ---------------------------------------------------------------------------
# AUTH_SECRET="generate-a-long-random-string-at-least-32-chars"
