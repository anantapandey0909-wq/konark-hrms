# ============================================================================
# Konark HRMS — Environment Variables (example)
# Copy this file to `.env` / `.env.local` and fill in real values.
# Never commit real secrets.
# ============================================================================

# PostgreSQL connection string (required for Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Phase 2/3 — authentication feature flags
# ---------------------------------------------------------------------------
USE_REAL_AUTH="false"
NEXT_PUBLIC_USE_REAL_AUTH="false"

# ---------------------------------------------------------------------------
# Phase 4/5 — real Employee/Department/Attendance/Leave data
# ---------------------------------------------------------------------------
# When false (default), those UIs use mock data.
# When true, list/create/update go through server actions → PostgreSQL.
# Requires real auth (USE_REAL_AUTH=true) so the server session can resolve tenant.
#
# IMPORTANT: After changing these, restart `next dev` (or rebuild).
# NEXT_PUBLIC_* values are read at process start.
NEXT_PUBLIC_USE_REAL_DATA="false"
# Optional server-only alias (same meaning as NEXT_PUBLIC_USE_REAL_DATA):
# USE_REAL_DATA="false"

# Legacy mock-data preference for modules not yet on real data.
# Ignored when NEXT_PUBLIC_USE_REAL_DATA=true.
NEXT_PUBLIC_USE_MOCK_DATA="true"

# ---------------------------------------------------------------------------
# Phase 3 — session signing secret (REQUIRED when USE_REAL_AUTH=true)
# Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
